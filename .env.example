# ==============================================================================
# Studio Sentinel — Environment Variables
# Google Cloud Agentic Cinema Hackathon (Grafana Labs Track)
# ==============================================================================

# ---- Mode Switch ----
# true  = deterministic rule-based analysis & direct status (no external API keys needed for local test)
# false = live multi-agent execution using Google Gemini 2.5 + Grafana Cloud / Loki
DIRECT_MODE=false

# ---- Database ----
# SQLite for instant local zero-dependency development
DATABASE_URL=sqlite:///./incidents.db
# Or connect to Supabase PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres"

# ---- Google Cloud / Gemini Enterprise (required when DIRECT_MODE=false) ----
GOOGLE_CLOUD_PROJECT=studio-sentinel-hack
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Grafana Cloud (required when DIRECT_MODE=false) ----
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token
LOKI_URL=https://logs-prod-xxx.grafana.net
LOKI_USER=your_loki_user_id
LOKI_API_KEY=your_loki_api_key
MCP_GRAFANA_URL=http://mcp-grafana:8000

# ---- Internal Service URLs ----
GENERATOR_URL=http://localhost:9000
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
